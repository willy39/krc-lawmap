{
  "name": "krc-lawmap",
  "version": "0.1.0",
  "private": true,
  "description": "대한적십자사 법규 지도 — 시범서비스",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "data": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/build-data.ts",
    "data:seed": "node --import tsx scripts/build-data.ts --seed",
    "probe": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/probe.ts",
    "prebuild": "node --import tsx scripts/publish-data.ts",
    "predev": "node --import tsx scripts/publish-data.ts",
    "data:book": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/krc-book.ts",
    "package:internal": "bash scripts/package-internal.sh"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node-html-parser": "9.0.4",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
